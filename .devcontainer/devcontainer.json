{
  "name": "AI Agent Sandbox Workspace",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": { "installZsh": true, "configureZshAsDefaultShell": true }
  },
  "postCreateCommand": "pip install --upgrade pip && if [ -f requirements.txt ]; then pip install -r requirements.txt; fi",
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": { "terminal.integrated.defaultProfile.linux": "bash", "python.defaultInterpreterPath": "/usr/local/bin/python" },
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}
